@echo off
REM ------------------------------------------------------------------
REM Copia este archivo como "ejecutar_local.bat" (sin ".ejemplo") y
REM completa tus datos reales abajo. "ejecutar_local.bat" ya está en
REM .gitignore, así que aunque subas la carpeta a GitHub, ese archivo
REM con tus credenciales reales NUNCA se sube.
REM ------------------------------------------------------------------

